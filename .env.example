# 原本的秘密，不要貼給別人
DISCORD_TOKEN=
OPENAI_API_KEY=

# Realtime
REALTIME_MODEL=gpt-realtime-1.5

# 沒有 Custom Voice 時的 fallback
REALTIME_VOICE=marin

# 建立 Custom Voice 用
VOICE_CONSENT_FILE=voice/source/consent.wav
VOICE_SAMPLE_FILE=voice/source/sample.wav
VOICE_NAME=Virtual Girlfriend
VOICE_LANGUAGE=zh-TW

# 可選：如果你已經有 voice_xxx，可直接填這裡
# 會優先於 voice/voice-config.json
CUSTOM_VOICE_ID=
